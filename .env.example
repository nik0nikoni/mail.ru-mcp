# Скопируй этот файл в .env и впиши свои данные.
# .env не коммить в git — там пароль.

EMAIL_USER=ты@mail.ru
# Пароль для внешних приложений (Mail.ru → Настройки → Безопасность), не обычный пароль
EMAIL_PASSWORD=пароль_приложения
EMAIL_TIMEZONE=Europe/Chisinau

# Необязательно:
# EMAIL_DOWNLOAD_DIR=C:\Users\ты\Downloads\mcp-email
# EMAIL_SAVE_SENT=false
